# Prod: /opt/galeri/.env olarak kopyala ve doldur. Bu dosya commit edilmez (.gitignore).
DB_URL=jdbc:postgresql://localhost:5432/galeri
DB_USER=galeri_app
DB_PASSWORD=

# En az 32 karakter. Uretmek icin: openssl rand -hex 32
JWT_SECRET=

SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8082
CORS_ALLOWED_ORIGINS=https://galeri.akillirandevum.com

MANAGEMENT_SERVER_PORT=9093
MANAGEMENT_SERVER_ADDRESS=127.0.0.1

# Web push (odeme gunu bildirimleri). Bos birakilirsa bildirimler kapali kalir.
# Uretmek icin: npx web-push generate-vapid-keys  (Public Key / Private Key satirlarini buraya kopyala)
# Anahtar cifti bir kez uretilir; degistirilirse panelde herkesin bildirime yeniden izin vermesi gerekir.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:burakgules06@gmail.com

# Ilk kurulum (tek seferlik). Hic galeri yoksa acilista galeriyi ve ADMIN'i olusturur; galeri varsa
# hicbir sey yapmaz ("Bootstrap atlandi" logu). Kullanim: doldur -> systemctl restart galeri ->
# logda "Bootstrap tamam" gor -> bu bes satiri sil -> tekrar restart. Sifre en az 8 karakter, sonra panelden degistir.
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_TENANT_SLUG=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
