meta {
  name: Partner capital movement
  type: http
  seq: 45
}

post {
  url: {{baseUrl}}/api/partners/{{contactId}}/capital
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "direction": "IN",
    "accountId": "{{accountId}}",
    "date": "2026-10-28",
    "amountCents": 1000000,
    "description": "Örnek sermaye girişi"
  }
}
