meta {
  name: Update vehicle
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/vehicles/{{vehicleId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "plate": "06 ABC 123",
    "make": "Toyota",
    "model": "Corolla 1.5 Vision",
    "modelYear": 2022,
    "fuel": "GASOLINE",
    "transmission": "AUTOMATIC",
    "mileageKm": 46000,
    "color": "Beyaz",
    "tramerCents": 0,
    "notes": "Güncellendi",
    "purchaseDate": "2026-10-28",
    "sellerId": "{{contactId}}",
    "boughtById": "{{userId}}",
    "actualPurchaseCents": 125000000,
    "officialPurchaseCents": 120000000,
    "purchaseAccountId": "{{accountId}}",
    "ownership": "DEALER"
  }
}
